# Optional: change this only if Spring Boot runs at a different address.
# Vite reads this server-side. Never put secrets in VITE_* variables.
API_PROXY_TARGET=http://127.0.0.1:8080
# Netlify build only: exact public HTTPS backend origin, no trailing slash.
# Leave unset for local development and the single-JAR deployment.
# VITE_API_BASE_URL=https://your-backend.onrender.com
